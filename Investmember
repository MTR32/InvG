<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="My Portfolio">
<meta name="theme-color" content="#0b0c0e">
<title>InvestGroup — My Portfolio</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%230b0c0e'/><text y='.9em' font-size='70' x='12' fill='%23c8f04a'>◆</text></svg>">
<link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%230b0c0e'/><text y='.9em' font-size='70' x='12' fill='%23c8f04a'>◆</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Mono:wght@400;500&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0c0e;--surface:#111318;--surface2:#181b22;--border:#232630;--accent:#c8f04a;--green:#4af0b8;--red:#f04a6a;--gold:#f0c14a;--blue:#4af0b8;--text:#e8eaf0;--muted:#6b7280;--muted2:#9ca3af;--nav-h:60px;}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html{height:100%;height:-webkit-fill-available;}
body{background:var(--bg);color:var(--text);font-family:'DM Mono',ui-monospace,monospace;font-size:13px;line-height:1.5;min-height:100vh;min-height:100dvh;overflow:hidden;position:fixed;width:100%;top:0;left:0;-webkit-text-size-adjust:100%;text-size-adjust:100%;}

#offline-banner{display:none;position:fixed;top:0;left:0;right:0;z-index:9000;background:rgba(240,74,106,.15);border-bottom:1px solid rgba(240,74,106,.3);padding:8px 16px;font-size:11px;color:var(--red);text-align:center;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
#offline-banner.show{display:block;}

/* LOGIN */
#login{position:fixed;inset:0;background:var(--bg);z-index:8000;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;}
#login.off{display:none;}
.lk-logo{font-family:'DM Serif Display',Georgia,serif;font-size:44px;color:var(--accent);margin-bottom:4px;}
.lk-title{font-family:'DM Serif Display',Georgia,serif;font-size:22px;color:var(--text);}
.lk-sub{font-size:9px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:28px;margin-top:2px;}
.lk-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:22px;width:100%;max-width:340px;}
.fl{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;display:block;margin-bottom:6px;}
.lk-select,.lk-input{width:100%;background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:11px 12px;border-radius:8px;font-family:'DM Mono',ui-monospace,monospace;font-size:13px;outline:none;transition:border-color .15s;margin-bottom:10px;}
.lk-select:focus,.lk-input:focus{border-color:var(--accent);}
.lk-btn{width:100%;background:var(--accent);color:#0b0c0e;border:none;border-radius:8px;padding:12px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:800;font-size:13px;cursor:pointer;margin-top:4px;}
.lk-err{color:var(--red);font-size:11px;text-align:center;margin-top:8px;min-height:16px;}
.lk-info{color:var(--muted);font-size:11px;text-align:center;margin-top:6px;}

/* APP */
#app{display:flex;flex-direction:column;height:100vh;height:100dvh;overflow:hidden;}
#app.off{display:none;}

/* TOPBAR */
.topbar{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;padding-top:calc(11px + env(safe-area-inset-top));background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;}
.tb-left{display:flex;align-items:center;gap:8px;min-width:0;flex:1;}
.tb-title{font-family:'DM Serif Display',Georgia,serif;font-size:17px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.tb-right{display:flex;align-items:center;gap:6px;flex-shrink:0;}
.tb-ghost{background:none;border:1px solid var(--border);color:var(--muted2);border-radius:6px;padding:6px 9px;font-size:14px;cursor:pointer;line-height:1;}
.back-btn{background:none;border:1px solid var(--border);color:var(--muted2);border-radius:6px;padding:5px 9px;font-size:11px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;}
.back-btn.hidden{display:none;}

/* SCROLL */
.scroll-area{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;padding-bottom:calc(var(--nav-h) + env(safe-area-inset-bottom));}
.page{display:none;padding:14px;}
.page.active{display:block;}

/* BOTTOM NAV */
.bottom-nav{display:flex;background:var(--surface);border-top:1px solid var(--border);flex-shrink:0;position:fixed;bottom:0;left:0;right:0;z-index:100;padding-bottom:env(safe-area-inset-bottom);height:calc(var(--nav-h) + env(safe-area-inset-bottom));}
.nav-tab{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 2px;cursor:pointer;color:var(--muted);font-size:8px;letter-spacing:.2px;text-transform:uppercase;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;gap:2px;border:none;background:none;overflow:hidden;}
.nav-tab .ni{font-size:20px;line-height:1;}
.nav-tab.active{color:var(--accent);}

/* KPI */
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;}
.kpi-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;position:relative;overflow:hidden;}
.kpi-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.kpi-card.yellow::after{background:var(--accent);}.kpi-card.green::after{background:var(--green);}.kpi-card.blue::after{background:var(--blue);}.kpi-card.red::after{background:var(--red);}.kpi-card.gold::after{background:var(--gold);}
.kl{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin-bottom:5px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
.kv{font-family:'DM Serif Display',Georgia,serif;font-size:22px;color:var(--text);letter-spacing:-.5px;line-height:1.1;}
.kv.green{color:var(--green);}.kv.red{color:var(--red);}.kv.gold{color:var(--gold);}
.ks{font-size:10px;color:var(--muted);margin-top:4px;}

/* CARD */
.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:12px;}
.card-hd{display:flex;align-items:center;justify-content:space-between;padding:11px 14px;border-bottom:1px solid var(--border);}
.card-title{font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;font-size:13px;color:var(--text);}
.card-body{padding:14px;}

/* TABLE */
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch;}
table{width:100%;border-collapse:collapse;font-size:11px;}
thead th{text-align:left;padding:8px 10px;font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);border-bottom:1px solid var(--border);white-space:nowrap;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
tbody tr{border-bottom:1px solid rgba(35,38,48,.5);}
tbody tr:last-child{border-bottom:none;}
tbody td{padding:9px 10px;color:var(--text);vertical-align:middle;}

/* BADGES */
.badge{display:inline-block;padding:2px 7px;border-radius:4px;font-size:9px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;letter-spacing:.3px;text-transform:uppercase;}
.bg{background:rgba(74,240,184,.12);color:var(--green);}.br{background:rgba(240,74,106,.12);color:var(--red);}
.by{background:rgba(200,240,74,.12);color:var(--accent);}.bgold{background:rgba(240,193,74,.12);color:var(--gold);}
.bb{background:rgba(74,240,184,.1);color:var(--blue);}.bm{background:rgba(107,114,128,.2);color:var(--muted2);}

/* FORMS */
.fg{display:flex;flex-direction:column;gap:5px;margin-bottom:12px;}
.fg:last-child{margin-bottom:0;}
label{font-size:9px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
input{background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:10px 12px;border-radius:8px;font-family:'DM Mono',ui-monospace,monospace;font-size:13px;outline:none;transition:border-color .15s;width:100%;}
input:focus{border-color:var(--accent);}

/* BUTTONS */
.btn{background:var(--accent);color:#0b0c0e;border:none;border-radius:8px;padding:12px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:800;font-size:13px;cursor:pointer;width:100%;}
.btn-g{background:transparent;border:1px solid var(--border);color:var(--muted2);border-radius:8px;padding:10px 12px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;font-size:12px;cursor:pointer;width:100%;}
.btn-sm{padding:5px 9px!important;font-size:10px!important;border-radius:6px!important;width:auto!important;}

/* MODAL */
.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:500;align-items:flex-end;justify-content:center;backdrop-filter:blur(3px);}
.mo.open{display:flex;}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:18px 18px 0 0;width:100%;max-width:520px;max-height:88vh;overflow-y:auto;animation:sup .2s ease;padding-bottom:env(safe-area-inset-bottom);}
@keyframes sup{from{transform:translateY(30px);opacity:0;}to{transform:translateY(0);opacity:1;}}
.mhandle{width:36px;height:4px;background:var(--border);border-radius:2px;margin:10px auto 0;cursor:pointer;}
.mhd{display:flex;align-items:center;justify-content:space-between;padding:14px 18px 10px;}
.mtitle{font-family:'DM Serif Display',Georgia,serif;font-size:18px;color:var(--text);}
.mclose{background:none;border:none;color:var(--muted);font-size:24px;cursor:pointer;line-height:1;}
.mbody{padding:0 18px 8px;}
.mfoot{padding:12px 18px 16px;display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--border);}

/* MISC */
.divider{height:1px;background:var(--border);margin:10px 0;}
.empty{text-align:center;padding:24px 12px;color:var(--muted);}
.empty-icon{font-size:26px;margin-bottom:8px;}
.prog-wrap{background:var(--surface2);border-radius:4px;height:5px;overflow:hidden;margin-top:5px;}
.prog-fill{height:100%;border-radius:4px;transition:width .4s;}
.tl{padding-left:16px;border-left:2px solid var(--border);}
.tl-item{position:relative;padding:0 0 12px 14px;}
.tl-item::before{content:'';position:absolute;left:-7px;top:4px;width:12px;height:12px;border-radius:50%;background:var(--surface2);border:2px solid var(--border);}
.tl-item.in::before{border-color:var(--green);background:rgba(74,240,184,.15);}
.tl-item.out::before{border-color:var(--red);background:rgba(240,74,106,.15);}
.tl-date{font-size:10px;color:var(--muted);}
.tl-desc{font-size:12px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
.tl-amt{font-size:12px;}
.section-title{font-family:'DM Serif Display',Georgia,serif;font-size:18px;margin-bottom:12px;}
.deposit-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);}
.deposit-row:last-child{border-bottom:none;}
.deposit-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;}
.deposit-value{font-size:13px;font-weight:700;color:var(--text);text-align:right;word-break:break-all;max-width:62%;}
.spinner{display:inline-block;width:18px;height:18px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite;vertical-align:middle;}
@keyframes spin{to{transform:rotate(360deg);}}
::-webkit-scrollbar{width:3px;height:3px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
</style>
</head>
<body>

<div id="offline-banner">⚡ No internet — showing last cached data</div>

<!-- ══ LOGIN ══ -->
<div id="login">
  <div class="lk-logo">◆</div>
  <div class="lk-title">My Portfolio</div>
  <div class="lk-sub">InvestGroup Member Access</div>
  <div class="lk-card">
    <span class="fl">Select Your Name</span>
    <select class="lk-select" id="login-name">
      <option value="">— Loading… —</option>
    </select>
    <span class="fl">Enter Your PIN</span>
    <input class="lk-input" type="password" id="login-pin" placeholder="••••" maxlength="10" inputmode="numeric">
    <button class="lk-btn" onclick="tryLogin()">Access My Portfolio →</button>
    <div class="lk-err" id="login-err"></div>
    <div class="lk-info" id="login-info"></div>
  </div>
</div>

<!-- ══ APP ══ -->
<div id="app" class="off">

  <div class="topbar">
    <div class="tb-left">
      <button class="back-btn hidden" id="back-btn" onclick="goBack()">← Back</button>
      <div class="tb-title" id="tb-title">My Portfolio</div>
    </div>
    <div class="tb-right">
      <span id="sync-dot" title="Sync status" style="font-size:12px;color:var(--muted)">●</span>
      <button class="tb-ghost" onclick="showPage('settings-pg')" title="Settings">⊙</button>
      <button class="tb-ghost" onclick="logout()" title="Logout" style="color:var(--red);border-color:rgba(240,74,106,.3);">⏻</button>
    </div>
  </div>

  <div class="scroll-area">

    <!-- DASHBOARD -->
    <div class="page active" id="page-dashboard">
      <!-- Member card -->
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px;">
        <div id="m-av" style="width:44px;height:44px;border-radius:50%;background:var(--surface2);border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;font-family:'Syne',ui-sans-serif,sans-serif;font-weight:800;font-size:15px;color:var(--accent);flex-shrink:0">--</div>
        <div style="flex:1;min-width:0;">
          <div id="m-name-d" style="font-family:'DM Serif Display',Georgia,serif;font-size:18px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">--</div>
          <div id="m-role-d" style="font-size:10px;color:var(--muted)">--</div>
        </div>
        <div style="text-align:right;flex-shrink:0;">
          <div id="m-eq-pct" style="font-family:'DM Serif Display',Georgia,serif;font-size:22px;color:var(--accent)">0%</div>
          <div style="font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px">Equity</div>
        </div>
      </div>

      <div class="kpi-grid">
        <div class="kpi-card yellow"><div class="kl">Contributed</div><div class="kv" id="m-in">--</div><div class="ks">Total paid in</div></div>
        <div class="kpi-card red"><div class="kl">Withdrawn</div><div class="kv red" id="m-out">--</div><div class="ks">Total taken out</div></div>
        <div class="kpi-card green"><div class="kl">Net Capital</div><div class="kv green" id="m-net">--</div><div class="ks">In the pool</div></div>
        <div class="kpi-card blue"><div class="kl">Inv. Profit</div><div class="kv" id="m-iprofit">--</div><div class="ks" id="m-iret">0% return</div></div>
      </div>

      <div class="card">
        <div class="card-hd"><div class="card-title">Net Worth Breakdown</div></div>
        <div class="card-body">
          <div style="display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:var(--muted)">Net Capital in Pool</span><span id="sw-net" style="font-weight:700">--</span></div>
            <div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:var(--muted)">Investment Gain Share</span><span id="sw-igain" style="font-weight:700">--</span></div>
            <div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:var(--muted)">Loan Interest Share</span><span id="sw-linc" style="color:var(--gold);font-weight:700">--</span></div>
            <div class="divider"></div>
            <div style="display:flex;justify-content:space-between;align-items:center;">
              <span style="font-family:'Syne',ui-sans-serif,sans-serif;font-weight:700;font-size:13px;">Final Net Worth</span>
              <span id="sw-nw" style="font-family:'DM Serif Display',Georgia,serif;font-size:22px;color:var(--green)">--</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:11px;"><span style="color:var(--muted)">Overall ROI</span><span id="sw-roi" style="font-weight:700">--</span></div>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;">
        <button class="btn" onclick="showPage('deposit-pg')">💰 Deposit</button>
        <button class="btn-g" onclick="showPage('invest-pg')">📈 Investments</button>
      </div>

      <div class="card">
        <div class="card-hd"><div class="card-title">Recent Activity</div><button class="btn-g btn-sm" onclick="showPage('tx-pg')">All →</button></div>
        <div class="card-body" style="padding:10px 14px;" id="m-recent">
          <div class="empty"><span class="spinner"></span></div>
        </div>
      </div>
    </div>

    <!-- INVESTMENTS -->
    <div class="page" id="page-invest">
      <div class="section-title">My Investments</div>
      <div class="kpi-grid">
        <div class="kpi-card blue"><div class="kl">My Input</div><div class="kv" id="i-in">--</div></div>
        <div class="kpi-card green"><div class="kl">My Value Now</div><div class="kv green" id="i-val">--</div></div>
        <div class="kpi-card yellow"><div class="kl">My Gain</div><div class="kv" id="i-gain">--</div></div>
        <div class="kpi-card gold"><div class="kl">My Equity</div><div class="kv gold" id="i-eq">--</div></div>
      </div>
      <div id="inv-cards"></div>
    </div>

    <!-- TRANSACTIONS -->
    <div class="page" id="page-tx">
      <div class="section-title">My Transactions</div>
      <div class="card">
        <div class="card-hd"><div class="card-title">History</div><span class="badge bm" id="tx-cnt">0</span></div>
        <div class="tw"><table><thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr></thead><tbody id="tx-body"></tbody></table></div>
      </div>
    </div>

    <!-- LOANS -->
    <div class="page" id="page-loans">
      <div class="section-title">My Loans</div>
      <div id="loan-cards"></div>
    </div>

    <!-- DEPOSIT -->
    <div class="page" id="page-deposit">
      <div class="section-title">Make a Deposit</div>
      <div style="background:rgba(200,240,74,.06);border:1px solid rgba(200,240,74,.2);border-radius:10px;padding:12px 14px;margin-bottom:12px;font-size:12px;color:var(--muted2);line-height:1.8;">
        Transfer to the group account below. Use the reference format shown so your payment is identified correctly.
      </div>
      <div class="card">
        <div class="card-hd"><div class="card-title">🏦 Group Bank Account</div></div>
        <div class="card-body" id="bank-card" style="padding:10px 14px;">
          <div class="empty"><span class="spinner"></span><div style="margin-top:8px">Loading details…</div></div>
        </div>
      </div>
      <div id="deposit-note-card" style="display:none;background:rgba(240,193,74,.07);border:1px solid rgba(240,193,74,.2);border-radius:10px;padding:12px 14px;font-size:12px;color:var(--gold);line-height:1.8;"></div>
    </div>

    <!-- SETTINGS -->
    <div class="page" id="page-settings">
      <div class="section-title">Settings</div>
      <div class="card">
        <div class="card-hd"><div class="card-title">My Account</div></div>
        <div class="card-body">
          <div style="font-size:12px;color:var(--muted2);margin-bottom:14px;">Signed in as <strong id="sett-name" style="color:var(--text)">
